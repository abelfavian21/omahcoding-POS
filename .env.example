APP_NAME=CashierStore
APP_ENV=production
APP_KEY=                       # php artisan key:generate
APP_DEBUG=false                # WAJIB false di production (true membocorkan kode, query & isi .env)
APP_URL=https://kasir.contoh.id
APP_TIMEZONE=Asia/Jakarta

# ---- Database: gunakan MySQL/PostgreSQL untuk produksi (SQLite hanya untuk dev) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cashierstore
DB_USERNAME=cashier_app        # user khusus aplikasi, bukan root
DB_PASSWORD=

# ---- Sesi & cookie ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true     # cookie hanya lewat HTTPS
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BCRYPT_ROUNDS=12
LOG_LEVEL=warning

# ---- Kebijakan POS ----
POS_REQUIRE_SHIFT=false
POS_CASHIER_MAX_DISCOUNT_PCT=10   # diskon manual maksimal kasir (% subtotal); admin tanpa batas
POS_ENFORCE_TRIAL=false           # true = akun trial yang habis masa berlakunya dikunci
POS_CSP_MODE=report               # report -> cek konsol browser -> ganti ke enforce
