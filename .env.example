APP_NAME=CashierStore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- Database ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cashierstore
DB_USERNAME=root
DB_PASSWORD=

# ---- Sesi & cookie (lokal = HTTP, jadi secure harus false) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# ---- Proxy (WAJIB diisi di produksi bila di belakang Nginx/Cloudflare/load balancer) ----
# IP/CIDR proxy dipisah koma, atau * bila server hanya bisa dijangkau lewat proxy. Kosong = lokal tanpa proxy.
TRUSTED_PROXIES=

# ---- Infrastruktur ----
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@cashierstore.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Info toko default (dipakai bila toko belum mengatur sendiri) ----
POS_STORE_NAME="Orely Cafe"
POS_STORE_ADDRESS="Jl. Slamet Riyadi No. 1, Surakarta"
POS_STORE_PHONE="0271-000000"
POS_TAX_RATE=0.10
POS_TAX_LABEL="Pajak (PB1)"
POS_RECEIPT_FOOTER="Terima kasih, sampai jumpa lagi!"

# ---- Kebijakan POS ----
POS_REQUIRE_SHIFT=true
POS_CASHIER_MAX_DISCOUNT_PCT=10
POS_POINT_VALUE=100
POS_ENFORCE_TRIAL=false
POS_CSP_MODE=report

# ---- Midtrans Payment Gateway ----
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_QRIS_ACQUIRER=gopay